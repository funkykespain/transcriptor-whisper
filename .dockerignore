# ---- Excluye del contexto de construcción Docker (no del repositorio Git) ----

# Control de versiones y tooling
.git
.gitignore
.dockerignore
.pytest_cache
**/__pycache__/
*.py[cod]

# Código que no entra en el contenedor de producción
tests/
scripts/

